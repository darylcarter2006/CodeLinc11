# Copy to .env.local for local overrides. Never put secrets here: every VITE_ variable
# is bundled into the public JavaScript.

# Backend origin. Leave empty in local dev to use the Vite proxy to http://localhost:8000.
VITE_API_BASE_URL=

# Dev-server only (not bundled): where the Vite proxy sends /v1 requests.
API_PROXY_TARGET=http://localhost:8000

# Google sign-in: an OAuth 2.0 "Web application" client ID from Google Cloud Console
# (APIs & Services > Credentials). It's public by design, but keep it in .env.local.
# Add http://localhost:5173 (and the deployed URL) under "Authorized JavaScript origins".
# Leave empty to show a placeholder button that explains Google sign-in isn't set up.
VITE_GOOGLE_CLIENT_ID=
