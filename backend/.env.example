# Copy to .env for local development. Never commit .env.
ENV=local
LOG_LEVEL=DEBUG

# Comma-separated explicit origins; "*" is rejected at startup.
CORS_ORIGINS=http://localhost:5173

# --- Repository backend ---
# "memory"   : no database needed (default for local dev and tests)
# "postgres" : requires DATABASE_URL below; run `docker compose up -d db` first
REPOSITORY_BACKEND=memory

# Required when REPOSITORY_BACKEND=postgres.
# Must use the postgresql+asyncpg:// scheme.
# For local dev (after `docker compose up -d db`):
#   DATABASE_URL=postgresql+asyncpg://insurance:localdev@localhost:5432/insurance
# For RDS (put the real values only in your own .env, never in this file):
#   DATABASE_URL=postgresql+asyncpg://insurance_app:<password>@<endpoint>:8080/insurance
#   DB_SSL_ROOT_CERT=./certs/global-bundle.pem
# See docs/database-setup.md.
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
# DB_SSL_ROOT_CERT=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# "stub"   : deterministic rule-based adapter, no API key required (default)
# "openai" : calls OpenAI Chat Completions; requires OPENAI_API_KEY below
AI_PROVIDER=stub
AI_TIMEOUT_SECONDS=15
# Requests per minute per client IP to /v1/ai/* (no login is required for these).
AI_RATE_LIMIT_PER_MINUTE=20

# --- OpenAI (required when AI_PROVIDER=openai) ---
# Get your key at https://platform.openai.com/api-keys — never commit it here.
# OPENAI_API_KEY=sk-...
# Optional model overrides (defaults shown):
# OPENAI_MODEL_FAST=gpt-4o-mini
# OPENAI_MODEL_SMART=gpt-4o

# --- Google sign-in (see docs/google-oauth-setup.md) ---
# OAuth "Web application" client ID. Not a secret, but leave empty to keep sign-in off.
GOOGLE_CLIENT_ID=
# Optional: only allow accounts from one Google Workspace domain, e.g. example.com
GOOGLE_HOSTED_DOMAIN=
ACCOUNT_TOKEN_TTL_HOURS=168
AUTH_RATE_LIMIT_PER_MINUTE=10

SESSION_TTL_HOURS=4
SESSION_TURN_LIMIT=40
MESSAGE_MAX_CHARS=2000
MAX_BODY_BYTES=16384
MESSAGE_HISTORY_TURNS=10
IDEMPOTENCY_TTL_HOURS=24
