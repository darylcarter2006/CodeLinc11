# Copy to .env for local development. Never commit .env.
ENV=local
LOG_LEVEL=DEBUG

# Comma-separated explicit origins; "*" is rejected at startup.
CORS_ORIGINS=http://localhost:5173

# Only "memory" and "stub" exist today; "postgres" and "bedrock" come in later steps.
REPOSITORY_BACKEND=memory
AI_PROVIDER=stub
AI_TIMEOUT_SECONDS=15

SESSION_TTL_HOURS=4
SESSION_TURN_LIMIT=40
MESSAGE_MAX_CHARS=2000
MAX_BODY_BYTES=16384
MESSAGE_HISTORY_TURNS=10
IDEMPOTENCY_TTL_HOURS=24
